<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="570.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.InterFace">
   <children>
      <BorderPane layoutX="10.0" layoutY="10.0" prefHeight="618.0" prefWidth="1080.0">
         <center>
            <AnchorPane prefHeight="640.0" prefWidth="1080.0">
               <children>
                  <TableView fx:id="scheduleTable" layoutX="0.0" layoutY="0.0" prefHeight="558.0" prefWidth="250.0">
                     <columns>
                        <TableColumn fx:id="courseCol" prefWidth="125" text="Course" />
                        <TableColumn fx:id="slotCol" prefWidth="125" text="Slot" />
                     </columns>
                  </TableView>

                  <LineChart fx:id="convergenceChart" layoutX="260.0" layoutY="0.0" prefHeight="567.0" prefWidth="817.0">
                     <xAxis>
                        <NumberAxis label="Generation" />
                     </xAxis>
                     <yAxis>
                        <NumberAxis label="Fitness" />
                     </yAxis>
                  </LineChart>

                  <HBox layoutX="0.0" layoutY="572.0" prefHeight="158.0" prefWidth="500.0">
                     <children>
                        <VBox prefHeight="130.0" prefWidth="206.0" spacing="15.0">
                           <children>
                              <HBox spacing="20.0">
                                 <children>
                                    <Label text="Population Size:" />
                                    <TextField fx:id="populationField" prefWidth="100" text="500" />
                                 </children>
                              </HBox>
                              <HBox spacing="20.0">
                                 <children>
                                    <Label text="Generations:" />
                                    <TextField fx:id="generationsField" prefWidth="100" text="500" />
                                 </children>
                              </HBox>
                              <HBox spacing="20.0">
                                 <children>
                                    <Label text="Mutation Rate:" />
                                    <TextField fx:id="mutationField" prefWidth="100" text="0.02" />
                                 </children>
                              </HBox>
                              <Button onAction="#runGA" text="Run" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </center>
         <bottom>
            <Label fx:id="fitnessLabel" style="-fx-padding: 10;" />
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
